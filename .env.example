# --- Database (Supabase Postgres) ---
# Use the "Transaction" pooler connection string from your Supabase project's
# Database settings (port 6543), since Vercel functions are serverless.
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# --- HERE (geocoding + truck routing) ---
# Create a free HERE developer account at https://platform.here.com and
# generate a REST API key.
HERE_API_KEY=

# --- Auth.js (admin dashboard login) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Only needed for local development
NEXTAUTH_URL=http://localhost:3000

# --- Seed script only (first admin user) ---
# Set these, run `npm run db:seed`, then remove them / change the password
# after your first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Existing quote-request email (unchanged) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
QUOTE_TO_EMAIL=
