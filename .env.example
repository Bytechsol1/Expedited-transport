# --- Database (Supabase Postgres) ---
# Use the "Transaction" pooler connection string from your Supabase project's
# Database settings (port 6543), since Vercel functions are serverless.
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# --- HERE (geocoding + truck routing) ---
# Create a free HERE developer account at https://platform.here.com and
# generate a REST API key.
HERE_API_KEY=

# --- Auth.js (admin dashboard login) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Only needed for local development
NEXTAUTH_URL=http://localhost:3000

# --- Seed script only (first admin user) ---
# Set these, run `npm run db:seed`, then remove them / change the password
# after your first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Stripe (Confirm Order / Pay Now on the instant quote) ---
# Get these from https://dashboard.stripe.com/test/apikeys while in test
# mode. Switch to live keys only when you're ready to accept real payments.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard (or `stripe
# listen` locally) — see https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Used to build Stripe's success/cancel redirect URLs. Set this to your
# real domain in production (e.g. https://expeditedtransportservices.net).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Existing quote-request email (unchanged) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
QUOTE_TO_EMAIL=
